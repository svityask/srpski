// Деплой на Cloudflare Workers (zdravo.srpski.workers.dev): статика приложения + маленький воркер с API (worker.js).
// Секреты задаются в панели Cloudflare (Workers → zdravo → Settings → Variables and Secrets), не здесь:
//   TELEGRAM_BOT_TOKEN — токен бота @BotFather, для отзывов из приложения;
//   GH_TOKEN — токен GitHub (доступ Actions: write к svityask/srpski), для будильника автопостинга.
{
  "name": "zdravo",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": ".", "binding": "ASSETS" },
  // куда присылать отзывы: личный чат владельца с ботом (не секрет — это просто адрес)
  "vars": { "FEEDBACK_CHAT_ID": "673873149" },
  "keep_vars": true,
  // будильник автопостинга: раз в 10 минут проверяет очередь и при необходимости запускает GitHub Actions
  // + еженедельный отчёт по понедельникам (worker.js → report)
  "triggers": { "crons": ["*/10 * * * *", "0 7 * * 1", "0 16 * * 4"] },
  // счётчики событий /api/e и лидов бота: Durable Object на SQLite (есть на бесплатном тарифе)
  "durable_objects": { "bindings": [{ "name": "STATS", "class_name": "Stats" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stats"] }],
  "observability": { "enabled": true }
}
